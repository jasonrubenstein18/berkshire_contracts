# Copy to .env and fill in. Never commit or share .env (scripts/package_submission.py leaves it out).

# Extraction, chat answers, and LLM-judged evaluation. Without it the app still runs, and chat shows the
# most relevant passages instead of a written answer.
OPENAI_API_KEY=

# Login for the web app. If unset, the app runs without a login screen.
APP_USERNAME=
APP_PASSWORD=

# Tokens for the /mcp endpoint: Claude Tag in Slack, and Copilot Studio in Teams. scripts/deploy_fly.py fills
# these in.
# MCP_TOKEN=
# COPILOT_MCP_TOKEN=

# Daily expiry email. scripts/deploy_fly.py fills in REMIND_TOKEN; copy it into the GitHub repository secret of
# the same name. Without RESEND_API_KEY the email is built but not sent. REMINDER_FROM must use a domain verified
# in Resend; REMINDER_TO is comma-separated.
# REMIND_TOKEN=
# RESEND_API_KEY=
# REMINDER_FROM=Contracts <reminders@example.com>
# REMINDER_TO=
# REMINDER_DAYS=14
# REMINDER_TIMEZONE=America/New_York

# Optional model overrides (defaults live in src/berkshire_contracts/config.py)
# EXTRACTION_MODEL=
# ESCALATION_MODEL=
# CHAT_MODEL=
# ROUTER_MODEL=
# JUDGE_MODEL=

# Optional app guardrails
# MAX_QUESTIONS_PER_MINUTE=6
# DAILY_LLM_BUDGET_USD=5
