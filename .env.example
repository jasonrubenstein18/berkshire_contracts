# Copy to .env and fill in. Never commit or share .env (scripts/package_submission.py leaves it out).

# Extraction, chat answers, and LLM-judged evaluation. Without it the app still runs, and chat shows the
# most relevant passages instead of a written answer.
OPENAI_API_KEY=

# Required only for scripts/deploy_space.py (write scope)
HF_TOKEN=

# Login for the web app. If unset, the app runs without a login screen.
APP_USERNAME=
APP_PASSWORD=

# Optional model overrides (defaults live in src/berkshire_contracts/config.py)
# EXTRACTION_MODEL=
# ESCALATION_MODEL=
# CHAT_MODEL=
# ROUTER_MODEL=
# JUDGE_MODEL=

# Optional app guardrails
# MAX_QUESTIONS_PER_MINUTE=6
# DAILY_LLM_BUDGET_USD=5
